def refactor_module(n_funcs: int = 12) -> str:
    """Deterministic ~150-line module; the task is a mechanical rename, so a
    correct answer copies almost every token from the prompt (MTP upper bound)."""
    out = ["import logging", "", "", "DEFAULTS = {\"scale\": 1.0, \"offset\": 0.0}", "", ""]
    for i in range(n_funcs):
        out.append(f'''def process_record_{i}(record, config, logger):
    """Validate and normalise record type {i} according to config."""
    if record is None:
        logger.warning("record {i} is None, skipping")
        return None
    value = record.get("value_{i}", 0)
    scale = config.get("scale_{i}", DEFAULTS["scale"])
    offset = config.get("offset_{i}", DEFAULTS["offset"])
    result = value * scale + offset
    if result < config.get("min_{i}", -1e9):
        logger.info("record {i} clamped at lower bound")
        result = config.get("min_{i}")
    if result > config.get("max_{i}", 1e9):
        logger.info("record {i} clamped at upper bound")
        result = config.get("max_{i}")
    record["normalised_{i}"] = result
    return record

''')
    return "\n".join(out)


