_WORDS = ("harbour lantern granite ledger monsoon copper orchard velvet quarry saffron meridian "
          "pilgrim tundra anvil cedar compass ember fjord glacier hollow ivory jasper kestrel "
          "lattice marrow nectar obsidian pewter quill raven sable talon umber vessel willow "
          "yarrow zephyr archive basalt cistern dune estuary furrow gable hearth isthmus juniper "
          "kiln loom mantle nomad oasis parapet quay reef sextant tallow undertow vellum wharf").split()


def prefill_prompt(n_tokens: int, seed: int = 7) -> str:
    """Seeded pseudo-random prose, ~3.6 chars/token on Qwen-class tokenizers, with
    no repeated passages (so nothing for prompt caching or ngram drafts to reuse)."""
    rng = random.Random(seed)
    target = int(n_tokens * 3.6)
    out, size = [], 0
    while size < target:
        n = rng.randint(7, 16)
        words = [rng.choice(_WORDS) for _ in range(n)]
        if rng.random() < 0.3:
            words.insert(rng.randint(1, n - 1), str(rng.randint(3, 9999)))
        s = " ".join(words).capitalize() + rng.choice([". ", ". ", ", ", "; ", ".\n"])
        out.append(s)
        size += len(s)
    return ("Read the following log carefully and then answer: which word occurs first?\n\n"
            + "".join(out) + "\nAnswer:")


@dataclass
class Preset:
    name: str
    kind: str                 # completion | chat
    n_predict: int
    fixed_len: bool
    note: str
    cases: tuple = ()         # vision presets: VISION_CASES keys, one request each

    def body(self, model: str, entry: Entry, opts: argparse.Namespace) -> dict:
        if self.cases:        # only the FIRST case -- used by preset_warmup; the
            # measured requests are built per case in measure_vision()
            b = VISION_CASES[self.cases[0]].body(model)
            if opts.n_predict:
                b["n_predict"] = opts.n_predict
            return b
        n_predict = opts.n_predict or self.n_predict
        common = {"n_predict": n_predict, "ignore_eos": self.fixed_len, "cache_prompt": False, "id_slot": 0}
        if self.name in ("prose", "json", "prefill", "depth"):
            if self.name in ("prefill", "depth"):
                n = opts.prefill_tokens if self.name == "prefill" else opts.depth_tokens
                if entry.ctx and n > entry.ctx - 1024:
                    n = entry.ctx - 1024
                    warn(f"{entry.key}: {self.name} capped to {n} tokens (ctx {entry.ctx})")
                prompt = prefill_prompt(n)
            else:
                prompt = PROSE_PROMPT if self.name == "prose" else JSON_PROMPT
            return {"prompt": prompt, **common}
        body = {"model": model, "stream": False, **common}
        if self.name == "refactor":
            body["messages"] = REFACTOR_MESSAGES
        elif self.name == "agent":
            body["messages"] = AGENT_MESSAGES
            body["tools"] = AGENT_TOOLS
            body["tool_choice"] = "auto"
        elif self.name == "tools":
            body["messages"] = TOOLS_MESSAGES
            body["tools"] = TOOLS_TOOL
            body["tool_choice"] = "auto"
        elif self.name == "reasoning":
            body["messages"] = REASONING_MESSAGES
            body["chat_template_kwargs"] = {"enable_thinking": True}
            body["reasoning_format"] = "deepseek"
        return body


PRESETS: dict[str, Preset] = {p.name: p for p in [
    Preset("prose", "completion", 512, True, "free prose -- speculative worst case"),
    Preset("json", "completion", 512, True, "structured JSON -- speculative best case"),
    Preset("refactor", "chat", 1024, True, "copy-heavy code edit (~2k-token module, mechanical rename)"),
    Preset("agent", "chat", 256, True, "agentic tool-calling transcript (~2.5k prompt tokens, 6 tools)"),
    Preset("tools", "chat", 256, False, "single tool call, natural stop; col: call/finish"),
    Preset("reasoning", "chat", 512, True, "enable_thinking on; col: think"),
    Preset("prefill", "completion", 16, True, "pure big-context prefill (--prefill-tokens, default 32768)"),
    Preset("depth", "completion", 256, True, "decode at depth: 256 tokens after a --depth-tokens prompt (default 32768); col: depth"),
    Preset("vision-ocr", "chat", 512, False, "full-page OCR of a rendered receipt; col: acc (character F1)",
           cases=VISION_OCR_CASES),
    Preset("vision-vqa", "chat", 64, False, "8 short visual questions (count/colour/chart/grid/OCR field); "
           "col: acc (graded answers)", cases=VISION_VQA_CASES),
]}
TEXT_PRESETS = [n for n, p in PRESETS.items() if not p.cases]
VISION_PRESETS = [n for n, p in PRESETS.items() if p.cases]
# group name -> preset names. `all` stays text-only (it is what every historic
# LLM_BENCHMARK.md row was produced with, and most entries take no image).
PRESET_GROUPS = {"all": TEXT_PRESETS, "vision": VISION_PRESETS, "full": TEXT_PRESETS + VISION_PRESETS}


def parse_presets(spec: str) -> list[Preset]:
    out: list[Preset] = []
    for token in spec.split(","):
        name = PROMPT_ALIASES.get(token.strip(), token.strip())
        for n in PRESET_GROUPS.get(name, [name]):
            if n not in PRESETS:
                raise UserError(f"unknown preset '{n}' (have: {', '.join(PRESETS)}; "
                                f"groups: {', '.join(PRESET_GROUPS)})")
            if PRESETS[n] not in out:
                out.append(PRESETS[n])
    return out


# ── rows / printers ──────────────────────────────────────────────────────────
@dataclass
class Row:
    model: str
    preset: str
    params: str
    pp: float | None = None
    tg: float | None = None
    tok: int | None = None
    accept: str = "-"
    vram: int | None = None
    gtt: int | None = None
    hash: str = "-"
    extra: dict = field(default_factory=dict)
    flags: list[str] = field(default_factory=list)
    error: str | None = None
    kernel: dict = field(default_factory=dict)   # kernel-mode columns


def _num(v: float | None, prec: int = 1) -> str:
    return "-" if v is None else f"{v:.{prec}f}"


class TablePrinter:
    """Fixed-width table printed incrementally (header once, one line per row as
    results arrive -- a full sweep takes many minutes)."""

    SERVER = [("model", 14, "l"), ("preset", 9, "l"), ("params", 44, "l"), ("pp t/s", 7, "r"),
              ("tg t/s", 7, "r"), ("tok", 6, "r"), ("accept", 6, "r"), ("vram", 6, "r"),
              ("gtt", 5, "r"), ("hash", 12, "l"), ("notes", 0, "l")]
    KERNEL = [("model", 14, "l"), ("variant", 8, "l"), ("params", 44, "l"), ("pp512", 14, "r"),
              ("tg128", 12, "r"), ("pp512@8k", 14, "r"), ("tg128@8k", 12, "r"), ("build", 16, "l"),
              ("notes", 0, "l")]

    def __init__(self, kernel: bool, enabled: bool = True):
        self.cols = self.KERNEL if kernel else self.SERVER
        self.kernel = kernel
        self.enabled = enabled

    def _line(self, cells: list[str]) -> str:
        out = []
        for (name, w, align), c in zip(self.cols, cells):
            if w == 0:
                out.append(c)
            else:
                out.append(c.rjust(w) if align == "r" else c.ljust(w))
        return "  ".join(out).rstrip()

    def header(self) -> None:
        if self.enabled:
            print(self._line([c[0] for c in self.cols]), flush=True)

    def row(self, r: Row) -> None:
        if not self.enabled:
            return
        if r.error:
            notes = f"FAILED: {r.error}"
        else:
            notes = " ".join([f"{k}={v}" for k, v in r.extra.items()] + r.flags)
        if self.kernel:
            k = r.kernel
            cells = [r.model, k.get("variant", "-"), r.params, k.get("pp512", "-"), k.get("tg128", "-"),
                     k.get("pp512@8k", "-"), k.get("tg128@8k", "-"), k.get("build", "-"), notes]
        else:
            cells = [r.model, r.preset, r.params, _num(r.pp), _num(r.tg),
                     "-" if r.tok is None else str(r.tok), r.accept,
                     "-" if r.vram is None else fmt_gib(r.vram),
                     "-" if r.gtt is None else fmt_gib(r.gtt), r.hash, notes]
        print(self._line(cells), flush=True)


def print_md(rows: list[Row], kernel: bool, today: str) -> None:
    if kernel:
        print("| Date | Model / entry | Config under test | Result | Why / notes |")
        print("|---|---|---|---|---|")
        for r in rows:
            k = r.kernel
            res = (f"pp512 **{k.get('pp512', '-')}**, tg128 **{k.get('tg128', '-')}**, "
                   f"pp512@8k {k.get('pp512@8k', '-')}, tg128@8k {k.get('tg128@8k', '-')}")
            print(f"| {today} | `{r.model}` | llama-bench {k.get('variant', '')} `{k.get('cmd', '')}` "
                  f"({r.params}) | {res} | build {k.get('build', '?')} {' '.join(r.flags)} |")
        return
    print("| Date | Model / entry | Config under test | Result | Why / notes |")
    print("|---|---|---|---|---|")
    for r in rows:
        if r.error:
            print(f"| {today} | `{r.model}` | {r.preset} ({r.params}) | FAILED: {r.error} | |")
            continue
        res = (f"pp **{_num(r.pp)}** / tg **{_num(r.tg)}** t/s, {r.tok} tok, accept {r.accept}, "
               f"vram {fmt_gib(r.vram or 0)}, gtt {fmt_gib(r.gtt or 0)}, hash `{r.hash}`")
        notes = " ".join([f"{k}={v}" for k, v in r.extra.items()] + r.flags)
        print(f"| {today} | `{r.model}` | benchmark `{r.preset}` greedy ({r.params}) | {res} | {notes} |")


def print_json(rows: list[Row], meta: dict) -> None:
    def enc(r: Row) -> dict:
        d = r.__dict__.copy()
        return d
    print(json.dumps({"meta": meta, "rows": [enc(r) for r in rows]}, indent=1))


# ── server-level runner ──────────────────────────────────────────────────────
_METRICS = ("llamacpp:prompt_tokens_total", "llamacpp:tokens_predicted_total")


def token_counters(target: Target | None) -> tuple[int, int] | None:
    """llama-server's Prometheus counters (needs --metrics on the entry); None if unavailable."""
    if target is None:
        return None
    status, raw = http("GET", f"{target.base}{target.prefix}/metrics", None, target.headers, 30)
    if status != 200:
        return None
    vals = {}
    for line in raw.decode(errors="replace").splitlines():
        for name in _METRICS:
            if line.startswith(name + " "):
                try:
                    vals[name] = int(float(line.split()[1]))
                except (ValueError, IndexError):
                    pass
    if len(vals) != 2:
        return None
    return vals[_METRICS[0]], vals[_METRICS[1]]


def measure_vision(target: Target, entry: Entry, preset: Preset, opts: argparse.Namespace,
                   sampled: bool) -> tuple[dict, str, dict]:
    """One request PER CASE -> (synthetic timings, hash, extras).

    The timings dict carries the same keys measure() returns, medianed over the
    cases (pp/tg) or summed (token counts), so bench_server needs no special
    case: a vision row's t/s is the typical per-question rate, and `tok` is the
    total generated. Accuracy is the point of the row and lands in extras:
      acc   mean case score, 0-100% (character F1 for ocr, right/wrong otherwise)
      ptok  median prompt tokens per case -- how many tokens THIS model spends on
            the same image; qwen35-* (dynamic ViT + --image-min-tokens) and
            lfm25-vl (SigLIP2 NaFlex) differ by a lot, and it explains their pp
      miss  cases scored below 0.5, by name
    """
    scores, ts, texts, misses = [], [], [], []
    for name in preset.cases:
        case = VISION_CASES[name]
        body = case.body(target.model)
        if opts.n_predict:
            body["n_predict"] = opts.n_predict
        if not sampled:
            body.update(GREEDY)
        d = target.post("/v1/chat/completions", body)
        msg = d["choices"][0]["message"]
        text = (msg.get("content") or "").strip()
        score = float(case.grade(text))
        scores.append(score)
        if score < 0.5:
            misses.append(name)
        ts.append(d.get("timings") or {})
        texts.append(text)
        if opts.vision_answers:
            print(f"  [{target.model} {name}] score {score:.2f} truth={case.truth!r}\n"
                  f"    {text[:600]!r}", file=sys.stderr, flush=True)

    def med(key: str) -> float:
        return statistics.median(t.get(key, 0) or 0 for t in ts)
    timings = {"prompt_per_second": med("prompt_per_second"),
               "predicted_per_second": med("predicted_per_second"),
               "prompt_n": sum(t.get("prompt_n", 0) or 0 for t in ts),
               "predicted_n": sum(t.get("predicted_n", 0) or 0 for t in ts),
               "draft_n": sum(t.get("draft_n", 0) or 0 for t in ts),
               "draft_n_accepted": sum(t.get("draft_n_accepted", 0) or 0 for t in ts)}
    extras = {"acc": f"{100 * statistics.mean(scores):.0f}%",
              "ptok": str(int(med("prompt_n")))}
    if misses:
        extras["miss"] = ",".join(misses)
    h = hashlib.sha256("\n".join(texts).encode()).hexdigest()[:12]
    return timings, h, extras


def measure(target: Target, entry: Entry, preset: Preset, opts: argparse.Namespace,
            sampled: bool) -> tuple[dict, str, dict]:
    """One measured request -> (timings, hash, extras)."""
    if preset.cases:
        return measure_vision(target, entry, preset, opts, sampled)
    body = preset.body(target.model, entry, opts)
    extras: dict = {}
    if sampled:
        # production sampling through llama-swap's filtered OpenAI route
        if "prompt" in body:
            body = {"model": target.model, "stream": False,
                    "messages": [{"role": "user", "content": body.pop("prompt")}],
                    **{k: v for k, v in body.items() if k not in ("prompt",)}}
        d = target.post("/v1/chat/completions", body)
        msg = d["choices"][0]["message"]
        h = "-"
    elif preset.kind == "completion":
        body.update(GREEDY)
        d = target.post("/completion", body)
        h = hashlib.sha256((d.get("content") or "").encode()).hexdigest()[:12]
        msg = None
    else:
        body.update(GREEDY)
        d = target.post("/v1/chat/completions", body)
        msg = d["choices"][0]["message"]
        h = hashlib.sha256(json.dumps(msg, sort_keys=True).encode()).hexdigest()[:12]
    if msg is not None:
        if preset.name in ("agent", "tools"):
            extras["call"] = "yes" if msg.get("tool_calls") else "no"
        if preset.name == "tools":
            extras["finish"] = d["choices"][0].get("finish_reason", "?")
        if preset.name == "reasoning":
            extras["think"] = "yes" if (msg.get("reasoning_content") or "").strip() else "no"
    t = d.get("timings") or {}
    if preset.name == "prefill":
        extras["ttft"] = f"{t.get('prompt_ms', 0) / 1000:.1f}s"
    if preset.name == "depth":
        extras["depth"] = t.get("prompt_n")
    return t, h, extras


def warmup(target: Target, sampled: bool) -> None:
    """Swap-load the model and warm it up; never measured. Two prompt sizes so both
    the small-batch and the full-ubatch prefill paths have run once (the first
    prefill of a new shape reads 2-3x slow on Vulkan)."""
    for prompt in (PROSE_PROMPT, prefill_prompt(700)):
        if sampled:  # llama-swap's own routes: only the OpenAI surface exists there
            target.post("/v1/chat/completions", {"model": target.model, "stream": False,
                                                 "messages": [{"role": "user", "content": prompt}],
                                                 "max_tokens": N_WARMUP, "cache_prompt": False, "id_slot": 0})
        else:
            target.post("/completion", {"prompt": prompt, "n_predict": N_WARMUP, "cache_prompt": False, **GREEDY})


def preset_warmup(target: Target, entry: Entry, preset: Preset, opts: argparse.Namespace, sampled: bool) -> None:
    """A 16-token dry run of the preset's own request (the old bench-models did this:
    it primes the exact prefill shape and the draft model's state). Skipped for
    prefill, whose whole point is the cold full-length prompt, and for depth (the
    dry run would cost a second full prefill; warmup() already ran both shapes)."""
    if preset.name in ("prefill", "depth"):
        return
    body = preset.body(target.model, entry, opts)
    body["n_predict"] = N_WARMUP
    body["ignore_eos"] = True
    if sampled:
        if "prompt" in body:
            body = {"model": target.model, "stream": False,
                    "messages": [{"role": "user", "content": body.pop("prompt")}], **body}
        target.post("/v1/chat/completions", body)
    elif preset.kind == "completion":
        target.post("/completion", {**body, **GREEDY})
    else:
        target.post("/v1/chat/completions", {**body, **GREEDY})


def bench_server(target: Target, entry: Entry, presets: list[Preset], opts: argparse.Namespace,
                 sampled: bool, params_extra: str | None, baseline_gtt: int, uma: bool,
                 emit, guard: Guard, metrics_target: Target | None) -> list[Row]:
    rows: list[Row] = []
    params = entry.params(params_extra)
    if any(p.cases for p in presets) and "image" not in entry.caps_in:
        for p in [p for p in presets if p.cases]:
            warn(f"{entry.key}: no image input (capabilities.in={entry.caps_in or '-'}), "
                 f"skipping preset {p.name}")
        presets = [p for p in presets if not p.cases]
        if not presets:
            return rows
    try:
        warmup(target, sampled)
    except Exception as ex:  # load failure: one FAILED row for the whole model
        rows = [Row(target.model, p.name, params, error=str(ex)) for p in presets]
        for r in rows:
            emit(r)
        return rows
    for p in presets:
        row = Row(target.model, p.name, params)
        try:
            preset_warmup(target, entry, p, opts, sampled)
            before = token_counters(metrics_target)
            runs = [measure(target, entry, p, opts, sampled) for _ in range(max(1, opts.repeat))]
            after = token_counters(metrics_target)
            t = runs[0][0]
            if before and after:   # anyone else on this server while we measured?
                ours_p = sum(r[0].get("prompt_n", 0) for r in runs)
                ours_g = sum(r[0].get("predicted_n", 0) for r in runs)
                if (after[0] - before[0] - ours_p) > 32 or (after[1] - before[1] - ours_g) > 32:
                    row.flags.append("SHARED")
            row.pp = statistics.median(r[0].get("prompt_per_second", 0) for r in runs)
            if p.name == "prefill":
                row.tg = None
                row.tok = t.get("prompt_n")
            else:
                row.tg = statistics.median(r[0].get("predicted_per_second", 0) for r in runs)
                row.tok = t.get("predicted_n")
            drafted = t.get("draft_n") or 0
            row.accept = f"{100 * t.get('draft_n_accepted', 0) / drafted:.0f}%" if drafted else "-"
            row.hash = runs[0][1]   # first run only -- see the docstring on hashes
            row.extra = runs[0][2]
            row.vram, row.gtt = vram_mib(), gtt_mib()
            if (not uma and opts.spill_threshold and entry.ngl == "all" and entry.fit != "on"
                    and row.gtt - baseline_gtt > opts.spill_threshold):
                row.flags.append("SPILL")
        except Exception as ex:
            row.error = str(ex)
        ev = guard.take()
        if ev:
            row.flags.append(f"EVICTED:{len(ev)}")
        rows.append(row)
        emit(row)
    return rows


# ── kernel-level runner ──────────────────────────────────────────────────────
def kernel_argv(entry: Entry, gguf: str, opts: argparse.Namespace, binary: str) -> list[str]:
    argv = [binary, "-m", gguf]
    if opts.std:
        argv += STANDARD_BENCH
    else:
        argv += ["-fa", "1", "-ctk", entry.ctk, "-ctv", entry.ctv,
                 "-b", str(entry.batch or 2048), "-ub", str(entry.ubatch or 512), "-p", "512", "-n", "128"]
        depth = opts.depth or ("0" if entry.ngl == "0" else "0,8192")
        argv += ["-d", depth]
        if entry.ngl not in (None, "all"):
            argv += ["-ngl", entry.ngl]
        if entry.fit == "on":
            argv += ["-fitt", str(FIT_MARGIN_MIB)]
        if entry.threads:
            argv += ["-t", str(entry.threads)]
        if entry.n_cpu_moe:
            argv += ["-ncmoe", str(entry.n_cpu_moe)]
        if entry.lazy_mode and entry.lazy_mode.startswith("on"):
            argv += ["-lzm", "on"]
    # The entry's load mode applies to --std too: it changes WHERE the weights live,
    # not how fast they run. Without it llama-bench falls back to llama.cpp's
    # default (`auto` = mmap off when a device lacks mmap support, i.e. Vulkan) and
    # copies every CPU-side tensor into pinned memory -- measured 2026-09-07 on
    # Strix Halo: Qwen3.8-Flash-Next with --n-cpu-moe 30 hit 77 GiB GTT during load
    # (the desktop-crash mechanism) where the same entry served at 45 GiB.
    if entry.load_mode:
        argv += ["-lm", entry.load_mode]
    argv += ["-r", str(opts.reps), "--progress", "-o", "json"]
    if opts.bench_args:
        argv += shlex.split(opts.bench_args)
    return argv


def bench_kernel(entry: Entry, opts: argparse.Namespace, variant: str, swap: Swap | None, guard: Guard) -> Row:
    binary = "llama-bench" + ("" if variant == "vulkan" else f"-{variant}")
    row = Row(entry.key, "kernel", entry.params(), kernel={"variant": variant})
    if not shutil.which(binary):
        have = sorted(os.path.basename(p) for d in os.environ["PATH"].split(":")
                      for p in glob.glob(os.path.join(d, "llama-bench*")))
        row.error = f"{binary} not in this image (have: {', '.join(have) or 'none'}; -rocm/-engram only in the :full tag)"
        return row
    try:
        gguf = resolve_gguf(entry)
    except UserError as ex:
        row.error = str(ex)
        return row
    argv = kernel_argv(entry, gguf, opts, binary)
    row.kernel["cmd"] = " ".join(shlex.quote(a) for a in argv[1:])
    print(f"+ {' '.join(shlex.quote(a) for a in argv)}", file=sys.stderr, flush=True)
    try:
        proc = subprocess.run(argv, stdout=subprocess.PIPE, stderr=None, timeout=opts.timeout * 4, check=False)
    except subprocess.TimeoutExpired:
        row.error = "llama-bench timed out"
        return row
    if proc.returncode != 0:
        row.error = f"llama-bench exit {proc.returncode}"
        return row
    try:
        results = json.loads(proc.stdout.decode() or "[]")
    except ValueError:
        row.error = "llama-bench printed no JSON"
        return row
    for r in results:
        label = f"pp{r['n_prompt']}" if r.get("n_prompt") else f"tg{r['n_gen']}"
        if r.get("n_depth"):
            label += f"@{r['n_depth'] // 1024}k"
        row.kernel[label] = f"{r['avg_ts']:.1f}±{r['stddev_ts']:.1f}"
        row.kernel["build"] = f"{r.get('build_number', '')} {r.get('build_commit', '')}".strip()
        row.kernel["model_type"] = r.get("model_type")
        row.kernel["file"] = os.path.basename(r.get("model_filename", gguf))
    ev = guard.take()
    if ev:
        row.flags.append(f"EVICTED:{len(ev)}")
    elif swap:
        try:
            if swap.running():
                row.flags.append("CONTAMINATED")
        except UserError:
            pass
    return row


# ── standalone runner ────────────────────────────────────────────────────────
def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def standalone_argv(entry: Entry, variant: str, port: int) -> list[str]:
    binary = "llama-server" + ("" if variant == "vulkan" else f"-{variant}")
    argv = [binary] + list(entry.argv[1:])   # ${PORT} was replaced by "0" at parse time
    for flag, value in (("--host", "127.0.0.1"), ("--port", str(port))):
        if flag in argv:
            argv[argv.index(flag) + 1] = value
        else:
            argv += [flag, value]
    return argv


class Standalone:
    def __init__(self, entry: Entry, variant: str, timeout: float):
        self.entry, self.variant, self.timeout = entry, variant, timeout
        self.port = free_port()
        self.proc: subprocess.Popen | None = None
        self.log = open(f"/tmp/benchmark-{entry.key}-{variant}.log", "wb")

    def __enter__(self) -> Target:
        argv = standalone_argv(self.entry, self.variant, self.port)
        if not shutil.which(argv[0]):
            raise UserError(f"{argv[0]} not in this image")
        print(f"+ {' '.join(shlex.quote(a) for a in argv)}", file=sys.stderr, flush=True)
        self.proc = subprocess.Popen(argv, stdout=self.log, stderr=subprocess.STDOUT)
        deadline = time.time() + max(self.entry.health_timeout, 60)
        base = f"http://127.0.0.1:{self.port}"
        while time.time() < deadline:
            if self.proc.poll() is not None:
                self.log.flush()
                tail = open(self.log.name, "rb").read()[-2000:].decode(errors="replace")
                raise RuntimeError(f"{argv[0]} exited with {self.proc.returncode}:\n{tail}")
            try:
                status, _ = http("GET", f"{base}/health", None, {}, 5)
                if status == 200:
                    return Target(base, "", {}, self.entry.key, self.timeout)
            except (urllib.error.URLError, OSError, ConnectionError):
                pass
            time.sleep(1)
        raise RuntimeError(f"{argv[0]} did not become healthy within {self.entry.health_timeout}s "
                           f"(log: {self.log.name})")

    def __exit__(self, *exc) -> None:
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(30)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
        self.log.close()


# ── main ─────────────────────────────────────────────────────────────────────
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="benchmark", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Benchmark llama-swap text entries (server-level), their GGUFs (llama-bench) "
                    "or a standalone llama-server variant.",
        epilog="presets:\n" + "\n".join(f"  {n:<12} {p.note}" for n, p in PRESETS.items())
               + "\ngroups:\n" + "\n".join(f"  {n:<12} {', '.join(v)}" for n, v in PRESET_GROUPS.items())
               + "\n\nexamples:\n  benchmark qwen38                      # all text presets, via llama-swap\n"
                 "  benchmark --prompt prose,json qwen38 qwen38-hh\n"
                 "  benchmark --prompt vision --vision-answers qwen35-4b qwen35-2b lfm25-vl\n"
                 "  benchmark --kernel --std --unload qwen38\n"
                 "  benchmark --standalone --variant rocm --unload qwen38\n"
                 "  benchmark --sampled qwen38:l\n  benchmark --list")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--kernel", action="store_true", help="llama-bench on the entry's GGUF (hardware/build number)")
    mode.add_argument("--standalone", action="store_true", help="spawn llama-server-<variant> with the entry's cmd")
    mode.add_argument("--sampled", action="store_true", help="via llama-swap /v1/chat/completions with filters (production sampling)")
    mode.add_argument("--list", action="store_true", help="list parsed llama-server entries, no requests")
    p.add_argument("--variant", choices=VARIANTS, help="llama.cpp build to use (--kernel/--standalone); default = the entry's binary")
    p.add_argument("--prompt", default="all",
                   help="comma-separated presets or a group: all (text, default), vision, full")
    p.add_argument("--vision-answers", action="store_true",
                   help="print every vision case's answer and score to stderr")
    p.add_argument("--vision-dump", metavar="DIR",
                   help="write the generated test PNGs to DIR and exit (no requests)")
    p.add_argument("--prefill-tokens", type=int, default=32768, help="prefill preset size (capped to ctx-1024)")
    p.add_argument("--depth-tokens", type=int, default=32768, help="depth preset: prompt length before the 256 measured tokens (capped to ctx-1024)")
    p.add_argument("--n-predict", type=int, help="override every preset's generated token count")
    p.add_argument("--repeat", type=int, default=1, help="measured runs per preset (median of t/s; hash from the first run)")
    p.add_argument("--format", choices=("table", "md", "json"), default="table")
    p.add_argument("--unload", action="store_true", help="GET /unload first (required for --kernel/--standalone when models are resident)")
    p.add_argument("--no-guard", action="store_true", help="do not evict models other services load during the run (default: evict + flag EVICTED)")
    p.add_argument("--spill-threshold", type=int, default=1536, help="MiB of gtt growth that flags SPILL (0 = off)")
    p.add_argument("--timeout", type=float, default=1200, help="per-request timeout in seconds (model load included)")
    p.add_argument("--config", default=CONFIG)
    p.add_argument("--base", default=BASE, help="llama-swap URL")
    p.add_argument("--std", action="store_true", help="--kernel: use the fixed community-comparable llama-bench line")
    p.add_argument("--depth", help="--kernel: -d list (default 0,8192; 0 for CPU entries)")
    p.add_argument("--reps", type=int, default=5, help="--kernel: llama-bench -r")
    p.add_argument("--bench-args", help="--kernel: extra llama-bench args, verbatim")
    p.add_argument("models", nargs="*", help="entry keys (default: every listed text entry)")
    return p


def cmd_list(cfg: Config) -> None:
    rows = []
    for e in cfg.llama_entries():
        rows.append([e.key, e.variant, ",".join(e.groups) or "-", e.params(),
                     f"{'+'.join(e.caps_in) or '-'}->{'+'.join(e.caps_out) or '-'}",
                     "unlisted" if e.unlisted else ("text" if e.is_text else "-"),
                     ",".join(e.tier_ids + e.aliases) or "-"])
    hdr = ["model", "variant", "group", "params", "caps", "bench", "aliases"]
    widths = [max(len(h), *(len(r[i]) for r in rows)) if rows else len(h) for i, h in enumerate(hdr)]
    print("  ".join(h.ljust(w) for h, w in zip(hdr, widths)))
    for r in rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)))
    print(f"\n{len(rows)} llama-server entries; 'bench'=text are the default sweep. "
          f"peers: {', '.join(cfg.peers) or 'none'}")


def main() -> int:
    opts = build_parser().parse_args()
    if opts.variant and not (opts.kernel or opts.standalone):
        raise UserError("--variant only applies to --kernel / --standalone")
    if opts.vision_dump:
        os.makedirs(opts.vision_dump, exist_ok=True)
        for name, build in IMAGES.items():
            c = build()
            path = os.path.join(opts.vision_dump, f"{name}.png")
            with open(path, "wb") as f:
                f.write(c.png())
            print(f"{path}  {c.w}x{c.h}")
        for c in VISION_CASES.values():
            print(f"{c.name:<9} {c.image:<6} truth={c.truth!r}  q={c.question}")
        return 0
    cfg = Config(opts.config)
    if opts.list:
        cmd_list(cfg)
        return 0
    presets = parse_presets(opts.prompt)
    key = os.environ.get("LLAMA_SWAP_API_KEY")
    swap = Swap(opts.base, key, opts.timeout)
    try:
        resident = swap.running()
    except UserError as ex:
        if opts.kernel or opts.standalone:
            warn(f"{ex}; continuing without llama-swap coordination")
            swap, resident = None, []
        else:
            raise
    load_notice()
    if opts.unload and swap and resident:
        warn(f"unloading {', '.join(resident)}")
        swap.unload()
        resident = []
    if (opts.kernel or opts.standalone) and resident:
        raise UserError(f"models resident in llama-swap ({', '.join(resident)}); pass --unload "
                        f"or wait -- the GPU must be free for this mode")
    if resident and not (opts.kernel or opts.standalone):
        warn(f"already resident: {', '.join(resident)} (gtt baseline includes them)")
    guard = Guard(swap, enabled=not opts.no_guard)
    baseline_gtt, uma = gtt_mib(), is_uma()
    if uma:
        warn("UMA GPU detected: gtt is the normal memory pool, SPILL check disabled")

    # model selection
    targets: list[tuple[Entry, str]] = []
    if opts.models:
        for name in opts.models:
            targets.append(cfg.resolve(name, opts.sampled))
    else:
        targets = [(e, e.key) for e in cfg.text_entries()]
    if not targets:
        raise UserError("no text entries found")

    today = _dt.date.today().isoformat()
    ver = versions()
    mode = "kernel" if opts.kernel else "standalone" if opts.standalone else "sampled" if opts.sampled else "server"
    meta = {"date": today, "mode": mode, "presets": [p.name for p in presets], "repeat": opts.repeat,
            "n_predict": opts.n_predict, "prefill_tokens": opts.prefill_tokens,
            "llama_vulkan_commit": ver.get("llama_vulkan_commit", "?").split()[0],
            "llama_patches": ver.get("llama_patches", ""),
            "llama_swap": ver.get("llama-swap", "?"), "models": [t[0].key for t in targets]}
    table = TablePrinter(kernel=opts.kernel, enabled=(opts.format == "table"))
    if opts.format == "table":
        print(f"benchmark {today} mode={mode} presets={','.join(meta['presets'])} repeat={opts.repeat} "
              f"llama.cpp={meta['llama_vulkan_commit'][:8]}"
              + (f" prs={meta['llama_patches'].replace(' ', ',')}" if meta['llama_patches'] else "")
              + (" SAMPLED -- not comparable with greedy rows" if opts.sampled else "") + "\n", flush=True)
        table.header()

    rows: list[Row] = []
    guard.start()
    for entry, model in targets:
        variant = opts.variant or entry.variant
        guard.allow(*([] if (opts.kernel or opts.standalone) else [entry.key]))
        if opts.kernel:
            row = bench_kernel(entry, opts, variant, swap, guard)
            rows.append(row)
            table.row(row)
            continue
        if opts.standalone:
            new: list[Row] = []
            try:
                with Standalone(entry, variant, opts.timeout) as tgt:
                    new = bench_server(tgt, entry, presets, opts, False, f"variant={variant}",
                                       baseline_gtt, uma, emit=lambda r: None, guard=guard, metrics_target=tgt)
            except (UserError, RuntimeError) as ex:
                new = [Row(entry.key, p.name, entry.params(f"variant={variant}"), error=str(ex)) for p in presets]
            if swap and not guard.enabled:
                try:
                    if swap.running():
                        for r in new:
                            r.flags.append("CONTAMINATED")
                except UserError:
                    pass
            for r in new:   # printed after teardown so CONTAMINATED can be included
                table.row(r)
            rows += new
            continue
        tgt = swap.openai(model) if opts.sampled else swap.upstream(entry.key)
        rows += bench_server(tgt, entry, presets, opts, opts.sampled, None, baseline_gtt, uma,
                             emit=table.row, guard=guard, metrics_target=swap.upstream(entry.key))
    guard.stop()

    if opts.format == "md":
        print_md(rows, opts.kernel, today)
    elif opts.format == "json":
        print_json(rows, meta)
    failed = [r for r in rows if r.error]
    flagged = [r for r in rows if r.flags]
    if failed or flagged:
        print(file=sys.stderr)
        for r in failed:
            warn(f"{r.model}/{r.preset} FAILED: {r.error}")
        for r in flagged:
            warn(f"{r.model}/{r.preset}: {' '.join(r.flags)}")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except UserError as ex:
        print(f"benchmark: {ex}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
