_AGENT_FILE = '''"""Inventory pricing helpers."""
from dataclasses import dataclass
from decimal import Decimal, ROUND_HALF_UP

TAX_RATES = {"PL": Decimal("0.23"), "DE": Decimal("0.19"), "CZ": Decimal("0.21")}


@dataclass
class Item:
    sku: str
    name: str
    net_price: Decimal
    quantity: int
    country: str = "PL"


def gross_price(item: Item) -> Decimal:
    rate = TAX_RATES[item.country]
    gross = item.net_price * (1 + rate)
    return gross.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)


def line_total(item: Item) -> Decimal:
    return gross_price(item) * item.quantity


def apply_discount(total: Decimal, percent: int) -> Decimal:
    if percent < 0 or percent > 100:
        raise ValueError("percent out of range")
    factor = Decimal(100 - percent) / Decimal(100)
    return (total * factor).quantize(Decimal("0.01"))


def basket_total(items: list[Item], discount_percent: int = 0) -> Decimal:
    subtotal = sum(line_total(i) for i in items)
    return apply_discount(subtotal, discount_percent)


def cheapest(items: list[Item]) -> Item:
    return min(items, key=lambda i: i.net_price)


def restock_needed(items: list[Item], threshold: int = 5) -> list[str]:
    return [i.sku for i in items if i.quantity <= threshold]


def format_receipt(items: list[Item]) -> str:
    lines = [f"{i.sku:<10} {i.name:<24} {i.quantity:>4} x {gross_price(i):>8} = {line_total(i):>9}"
             for i in items]
    lines.append("-" * 60)
    lines.append(f"{'TOTAL':<41} {basket_total(items):>18}")
    return "\\n".join(lines)
'''

