    import yaml
except ImportError:  # image without python3-yaml (pre-2026-09 builds): re-exec via uv
    if os.environ.get("BENCHMARK_REEXEC") or not shutil.which("uv"):
        sys.exit("benchmark: PyYAML missing -- apt-get install python3-yaml "
                 "(or have uv on PATH for the fallback)")
    os.environ["BENCHMARK_REEXEC"] = "1"
    os.execvp("uv", ["uv", "run", "--quiet", "--no-project", "--with", "pyyaml",
                     "python3", os.path.abspath(__file__), *sys.argv[1:]])

# ── constants ────────────────────────────────────────────────────────────────
CONFIG = "/etc/llama-swap/config/config.yaml"
BASE = "http://localhost:8080"
VERSIONS = "/versions.txt"
N_WARMUP = 16
# id_slot pins every request to slot 0: on --parallel N servers the slot (and with
# --kv-unified the position in the shared cache) would otherwise vary between
# identical requests and change the greedy path -> spurious DRIFT.
GREEDY = {"temperature": 0, "top_k": 1, "seed": 42, "id_slot": 0}
# The community-comparable llama-bench line (LLM_BENCHMARK.md, "kernel-level").
STANDARD_BENCH = ["-fa", "1", "-ctk", "q8_0", "-ctv", "q4_0", "-b", "2048", "-ub", "512",
                  "-p", "512", "-n", "128", "-d", "0,8192"]
FIT_MARGIN_MIB = 1024  # llama-server's --fit on default margin (1 GiB)
VARIANTS = ("vulkan", "rocm", "engram")
SIDECAR_PREFIXES = ("mmproj-", "mtp-", "dflash-", "eagle3-", "dspark-")
PROMPT_ALIASES = {"story": "prose", "code": "json"}


class UserError(Exception):
    """Preflight / usage problem: message to stderr, exit 2."""


def warn(msg: str) -> None:
    print(f"benchmark: {msg}", file=sys.stderr, flush=True)


# ── config entries ───────────────────────────────────────────────────────────
@dataclass
class Entry:
    key: str
    argv: list[str]
    binary: str
    hf_repo: str | None = None
    hf_tag: str | None = None
    hf_file: str | None = None
    model_path: str | None = None
    draft_repo: str | None = None
    draft_file: str | None = None
    ctx: int | None = None
    ctk: str = "f16"
    ctv: str = "f16"
    batch: int | None = None
    ubatch: int | None = None
    ngl: str | None = None          # "all", "0", "12" ... None = binary default
    fit: str | None = None          # "on"/"off"
    spec_type: str | None = None
    spec_nmax: int | None = None
    threads: int | None = None
    n_cpu_moe: int | None = None
    lazy_mode: str | None = None
    load_mode: str | None = None
    caps_in: list[str] = field(default_factory=list)
    caps_out: list[str] = field(default_factory=list)
    unlisted: bool = False
    aliases: list[str] = field(default_factory=list)
    tier_ids: list[str] = field(default_factory=list)   # setParamsByID keys (${MODEL_ID}:l ...)
    groups: list[str] = field(default_factory=list)
    health_timeout: int = 300

    @property
    def variant(self) -> str:
        m = re.match(r"llama-server(?:-(\w+))?$", os.path.basename(self.binary))
        return (m.group(1) if m and m.group(1) else "vulkan")

    @property
    def is_text(self) -> bool:
        return (os.path.basename(self.binary).startswith("llama-server")
                and "text" in self.caps_out and "text" in self.caps_in)

    @property
    def quant(self) -> str:
        if self.hf_tag:
            return self.hf_tag
        stem = os.path.splitext(os.path.basename(self.hf_file or self.model_path or ""))[0]
        m = re.search(r"[-.]([A-Za-z0-9_]+)$", stem)
        return m.group(1) if m else (stem or "?")

    def params(self, extra: str | None = None) -> str:
        def kv(t: str) -> str:
            return {"q8_0": "q8", "q4_0": "q4", "q4_1": "q4_1", "q5_0": "q5", "q5_1": "q5_1",
                    "iq4_nl": "iq4", "f16": "f16", "bf16": "bf16", "f32": "f32"}.get(t, t)
        parts = [self.quant]
        if self.ctx:
            parts.append(f"{self.ctx // 1000}k")   # 131072 -> 131k, as in the benchmark log
        parts.append(f"{kv(self.ctk)}/{kv(self.ctv)}" if self.ctk != self.ctv else kv(self.ctk))
        if self.spec_type:
            s = self.spec_type.replace("draft-", "")
            if self.spec_nmax is not None:
                s += str(self.spec_nmax)
            if self.draft_file:
                s += "+sidecar"
            parts.append(s)
        if self.fit == "on":
            parts.append("fit")
        elif self.ngl is not None:
            parts.append(f"ngl={self.ngl}")
        if self.batch or self.ubatch:
            parts.append(f"b{self.batch or 2048}/{self.ubatch or 512}")
        if extra:
            parts.append(extra)
        return " ".join(parts)


# flag -> (attribute, converter)
_FLAGS: dict[str, tuple[str, type | None]] = {
    "--ctx-size": ("ctx", int), "-c": ("ctx", int),
    "--cache-type-k": ("ctk", None), "-ctk": ("ctk", None),
    "--cache-type-v": ("ctv", None), "-ctv": ("ctv", None),
    "--batch-size": ("batch", int), "-b": ("batch", int),
    "--ubatch-size": ("ubatch", int), "-ub": ("ubatch", int),
    "--n-gpu-layers": ("ngl", None), "-ngl": ("ngl", None), "--gpu-layers": ("ngl", None),
    "--fit": ("fit", None),
    "--spec-type": ("spec_type", None),
    "--spec-draft-n-max": ("spec_nmax", int),
    "--spec-draft-hf": ("draft_repo", None), "-hfd": ("draft_repo", None),
    "--spec-draft-model": ("draft_file", None), "-md": ("draft_file", None),
    "--hf-file": ("hf_file", None), "-hff": ("hf_file", None),
    "--model": ("model_path", None), "-m": ("model_path", None),
    "--threads": ("threads", int), "-t": ("threads", int),
    "--n-cpu-moe": ("n_cpu_moe", int), "-ncmoe": ("n_cpu_moe", int),
    "--lazy-mode": ("lazy_mode", None), "-lzm": ("lazy_mode", None),
    "--load-mode": ("load_mode", None), "-lm": ("load_mode", None),
}


def parse_entry(key: str, m: dict, cfg: dict) -> Entry:
    cmd = (m.get("cmd") or "").replace("${PORT}", "0")
    argv = shlex.split(cmd)
    if not argv:
        raise UserError(f"{key}: empty cmd")
    e = Entry(key=key, argv=argv, binary=argv[0])
    i = 1
    while i < len(argv):
        a = argv[i]
        nxt = argv[i + 1] if i + 1 < len(argv) else None
        if a in ("-hf", "-hfr", "--hf-repo") and nxt:
            repo, _, tag = nxt.partition(":")
            e.hf_repo, e.hf_tag = repo, (tag or None)
            i += 2
            continue
        if a in _FLAGS and nxt is not None and not nxt.startswith("-"):
            attr, conv = _FLAGS[a]
            try:
                setattr(e, attr, conv(nxt) if conv else nxt)
            except ValueError:
                pass
            i += 2
            continue
        i += 1
    caps = m.get("capabilities") or {}
    e.caps_in = list(caps.get("in") or [])
    e.caps_out = list(caps.get("out") or [])
    e.unlisted = bool(m.get("unlisted"))
    e.aliases = list(m.get("aliases") or [])
    e.tier_ids = [k.replace("${MODEL_ID}", key)
                  for k in ((m.get("filters") or {}).get("setParamsByID") or {})]
    e.groups = [g for g, gd in (cfg.get("groups") or {}).items()
                if key in (gd.get("members") or [])]
    e.health_timeout = int(cfg.get("healthCheckTimeout") or 300)
    return e


class Config:
    def __init__(self, path: str):
        with open(path) as f:
            self.raw = yaml.safe_load(f) or {}
        self.path = path
        self.entries: dict[str, Entry] = {}
        for key, m in (self.raw.get("models") or {}).items():
            try:
                self.entries[key] = parse_entry(key, m or {}, self.raw)
            except UserError as ex:
                warn(str(ex))
        self.peers = self.raw.get("peers") or {}

    def text_entries(self) -> list[Entry]:
        return [e for e in self.entries.values() if e.is_text and not e.unlisted]

    def llama_entries(self) -> list[Entry]:
        return [e for e in self.entries.values()
                if os.path.basename(e.binary).startswith("llama-server")]

    def resolve(self, name: str, sampled: bool) -> tuple[Entry, str]:
        """-> (entry, model field to send). Aliases resolve to their parent."""
        if "/" in name:
            peer, _, rest = name.partition("/")
            if peer in self.peers:
                raise UserError(f"{name}: served by remote peer '{peer}' -- run benchmark on that box")
        for peer, pd in self.peers.items():
            if name in (pd.get("models") or []) and name not in self.entries:
                raise UserError(f"{name}: only exists on peer '{peer}' -- run benchmark on that box")
        if name in self.entries:
            e = self.entries[name]
        else:
            parent = next((e for e in self.entries.values()
                           if name in e.aliases or name in e.tier_ids), None)
            if parent is None:
                raise UserError(f"{name}: not a model in {self.path} (try --list)")
            e = parent
            if not sampled:
                warn(f"{name} is an alias of {e.key}; filters do not apply via /upstream, "
                     f"benchmarking {e.key} (use --sampled to bench the alias itself)")
                name = e.key
        if not os.path.basename(e.binary).startswith("llama-server"):
            raise UserError(f"{e.key}: not a llama-server entry ({os.path.basename(e.binary)})")
        if "text" not in e.caps_out:
            raise UserError(f"{e.key}: not a text-output entry (capabilities.out={e.caps_out})")
        return e, name


# ── HF cache resolution (kernel mode) ────────────────────────────────────────
def hub_dir() -> str:
    for var in ("LLAMA_CACHE", "HF_HUB_CACHE"):
        if os.environ.get(var):
            return os.environ[var]
    if os.environ.get("HF_HOME"):
        return os.path.join(os.environ["HF_HOME"], "hub")
    return os.path.expanduser("~/.cache/huggingface/hub")


def cached_files(repo: str) -> tuple[str, list[str]]:
    """-> (snapshot dir, relative paths) the way llama.cpp's hf_cache reads it."""
    d = os.path.join(hub_dir(), "models--" + repo.replace("/", "--"))
    refs = os.path.join(d, "refs")
    if not os.path.isdir(refs):
        raise UserError(f"{repo}: not in the HF cache ({d}) -- run update-models or load the entry once")
    ref = os.path.join(refs, "main")
    if not os.path.isfile(ref):
        cands = sorted(os.listdir(refs))
        if not cands:
            raise UserError(f"{repo}: no refs in {refs}")
        ref = os.path.join(refs, cands[0])
    sha = open(ref).read().strip()
    snap = os.path.join(d, "snapshots", sha)
    if not os.path.isdir(snap):
        raise UserError(f"{repo}: snapshot {sha} missing under {d}/snapshots")
    files = []
    for root, _dirs, names in os.walk(snap):
        for n in names:
            files.append(os.path.relpath(os.path.join(root, n), snap))
    return snap, sorted(files)


def is_model_gguf(rel: str) -> bool:
    b = os.path.basename(rel)
    return b.endswith(".gguf") and not b.startswith(SIDECAR_PREFIXES)


def resolve_gguf(e: Entry) -> str:
    if e.model_path:
        if not os.path.exists(e.model_path):
            raise UserError(f"{e.key}: {e.model_path} does not exist")
        return e.model_path
    if not e.hf_repo:
        raise UserError(f"{e.key}: no -hf / -m in cmd, cannot locate the GGUF")
    snap, files = cached_files(e.hf_repo)
    if e.hf_file:
        if e.hf_file in files:
            return os.path.join(snap, e.hf_file)
        raise UserError(f"{e.key}: {e.hf_file} not in the cached snapshot of {e.hf_repo}")
    tag = e.hf_tag or "Q4_K_M"
    pat = re.compile(re.escape(tag) + r"[.-]", re.IGNORECASE)
    shard = re.compile(r"-(\d{5})-of-\d{5}\.gguf$")
    cands = []
    for rel in files:
        if not is_model_gguf(rel) or not pat.search(rel):
            continue
        m = shard.search(rel)
        if m and int(m.group(1)) != 1:
            continue
        cands.append(rel)
    if not cands:
        raise UserError(f"{e.key}: no GGUF matching '{tag}' in the cached {e.hf_repo} "
                        f"-- run update-models or load the entry once")
    exact = [c for c in cands if re.search(r"[-.]" + re.escape(tag) + r"(-00001-of-\d{5})?\.gguf$",
                                           os.path.basename(c), re.IGNORECASE)]
    pick = (exact or cands)[0]
    if len(cands) > 1:
        warn(f"{e.key}: several GGUFs match '{tag}' ({', '.join(cands)}); using {pick}")
    return os.path.join(snap, pick)


# ── HTTP / llama-swap ────────────────────────────────────────────────────────
def http(method: str, url: str, body: dict | None = None, headers: dict | None = None,
         timeout: float = 60) -> tuple[int, bytes]:
    data = json.dumps(body).encode() if body is not None else None
    h = {"Content-Type": "application/json", **(headers or {})}
    req = urllib.request.Request(url, data=data, headers=h, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as ex:
        return ex.code, ex.read()


class Target:
    """Where requests go: llama-swap upstream proxy, llama-swap OpenAI route, or a
    standalone llama-server. Presets only ever call post()/get()."""

    def __init__(self, base: str, prefix: str, headers: dict, model: str, timeout: float):
        self.base, self.prefix, self.headers, self.model, self.timeout = base, prefix, headers, model, timeout

    def post(self, path: str, body: dict) -> dict:
        status, raw = http("POST", f"{self.base}{self.prefix}{path}", body, self.headers, self.timeout)
        if status != 200:
            raise RuntimeError(f"HTTP {status} on {self.prefix}{path}: {raw[:300].decode(errors='replace')}")
        return json.loads(raw)

    def get(self, path: str) -> dict | None:
        status, raw = http("GET", f"{self.base}{self.prefix}{path}", None, self.headers, self.timeout)
        if status != 200:
            return None
        try:
            return json.loads(raw)
        except ValueError:
            return None


class Swap:
    def __init__(self, base: str, key: str | None, timeout: float):
        self.base = base
        self.headers = {"Authorization": f"Bearer {key}"} if key else {}
        self.timeout = timeout

    def running(self) -> list[str]:
        status, raw = http("GET", f"{self.base}/running", None, self.headers, 30)
        if status == 401:
            raise UserError("llama-swap rejected the API key (401) -- set LLAMA_SWAP_API_KEY")
        if status != 200:
            raise UserError(f"llama-swap /running -> HTTP {status}: {raw[:200].decode(errors='replace')}")
        return [r["model"] for r in json.loads(raw).get("running", []) if r.get("state") != "stopped"]

    def unload_model(self, model: str) -> bool:
        status, _ = http("POST", f"{self.base}/api/models/unload/{model}", None, self.headers, 60)
        return status == 200

    def unload(self) -> None:
        status, raw = http("GET", f"{self.base}/unload", None, self.headers, 120)
        if status != 200:
            raise UserError(f"/unload -> HTTP {status}: {raw[:200].decode(errors='replace')}")
        for _ in range(60):
            if not self.running():
                time.sleep(2)  # let the driver free VRAM
                return
            time.sleep(1)
        raise UserError("models still resident 60 s after /unload")

    def upstream(self, key: str) -> Target:
        return Target(self.base, f"/upstream/{key}", self.headers, key, self.timeout)

    def openai(self, model: str) -> Target:
        return Target(self.base, "", self.headers, model, self.timeout)


class Guard:
    """Keeps llama-swap free of everything but the model under test for the whole
    run (see the docstring). allowed = set of model keys that may be resident."""

    def __init__(self, swap: Swap | None, enabled: bool):
        self.swap, self.enabled = swap, enabled and swap is not None
        self.allowed: set[str] = set()
        self.ours: set[str] = set()       # models this run loaded earlier (cpu-group ttl keeps them resident)
        self.evicted: list[str] = []      # intruders seen since the last take()
        self._stop = threading.Event()
        self._lock = threading.Lock()
        self._thread = threading.Thread(target=self._run, daemon=True)

    def start(self) -> None:
        if self.enabled:
            self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        if self.enabled and self._thread.is_alive():
            self._thread.join(5)

    def allow(self, *models: str) -> None:
        with self._lock:
            self.ours |= self.allowed          # what we benchmarked before is ours, not an intruder
            self.allowed = set(models)

    def take(self) -> list[str]:
        with self._lock:
            out, self.evicted = self.evicted, []
        return out

    def _run(self) -> None:
        while not self._stop.wait(0.5):
            try:
                resident = self.swap.running()
            except UserError:
                continue
            with self._lock:
                intruders = [m for m in resident if m not in self.allowed]
            for m in intruders:
                with self._lock:
                    ours = m in self.ours
                if not ours:
                    warn(f"guard: evicting {m} (loaded by someone else during the benchmark)")
                try:
                    if not self.swap.unload_model(m):
                        self.swap.unload()  # alias/unknown -> drop everything (allowed model reloads on demand)
                except UserError:
                    pass
                if not ours:
                    with self._lock:
                        self.evicted.append(m)


def versions() -> dict[str, str]:
    out = {}
    try:
        for line in open(VERSIONS):
            k, _, v = line.partition(":")
            if _:
                out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


# ── host / GPU state ─────────────────────────────────────────────────────────
def _sysfs_sum(name: str) -> int:
    total = 0
    for f in glob.glob(f"/sys/class/drm/card*/device/{name}"):
        try:
            total += int(open(f).read())
        except (OSError, ValueError):
            pass
    return total


def vram_mib() -> int:
    return _sysfs_sum("mem_info_vram_used") >> 20


def gtt_mib() -> int:
    return _sysfs_sum("mem_info_gtt_used") >> 20


def is_uma() -> bool:
    """iGPU/APU heuristic: a 'VRAM' carve-out of <= 4 GiB means the real pool is GTT."""
    totals = [int(open(f).read()) for f in glob.glob("/sys/class/drm/card*/device/mem_info_vram_total")
              if os.path.exists(f)]
    return bool(totals) and max(totals) <= (4 << 30)


def load_notice() -> None:
    try:
        load1 = float(open("/proc/loadavg").read().split()[0])
    except (OSError, ValueError):
        return
    if load1 > (os.cpu_count() or 1) / 2:
        warn(f"box is not idle (loadavg {load1:.1f}) -- numbers may read low")


def fmt_gib(mib: int) -> str:
    return f"{mib / 1024:.1f}G"


# ── vision test images (self-contained: no PIL/ImageMagick in the image) ─────
# Every vision preset renders its own PNGs at run time from the tables below,
# so the benchmark has no binary assets and the images are bit-identical on
# every box and every image build (the accuracy scores are only comparable if
# the input is). `--vision-dump DIR` writes them out to look at.
#
# FONT5X7: a 5x7 bitmap font, one entry per glyph, seven base32 digits = seven
# 5-bit rows (bit 4 = leftmost pixel). Rendered at scale 4-12, so a glyph is
# 20-60 px tall — coarse but crisp, and every VLM tested reads it. To eyeball a
# glyph: for r in FONT5X7["A"]: print(f"{_B32.index(r):05b}".replace("0"," ").replace("1","#"))
FONT5X7 = {
    '0':'EHJLPHE', '1':'4C4444E', '2':'EH1248V', '3':'V2421HE', '4':'26AIV22', '5':'VGU11HE',
    '6':'68GUHHE', '7':'V124888', '8':'EHHEHHE', '9':'EHHF12C', 'A':'4AHHVHH', 'B':'UHHUHHU',
    'C':'EHGGGHE', 'D':'SIHHHIS', 'E':'VGGUGGV', 'F':'VGGUGGG', 'G':'EHGJHHE', 'H':'HHHVHHH',
    'I':'E44444E', 'J':'72222IC', 'K':'HIKOKIH', 'L':'GGGGGGV', 'M':'HRLLHHH', 'N':'HHPLJHH',
    'O':'EHHHHHE', 'P':'UHHUGGG', 'Q':'EHHHLID', 'R':'UHHUKIH', 'S':'FGGE11U', 'T':'V444444',
    'U':'HHHHHHE', 'V':'HHHHHA4', 'W':'HHHLLRH', 'X':'HHA4AHH', 'Y':'HHA4444', 'Z':'V1248GV',
    ' ':'0000000', '.':'00000CC', ',':'0000CC8', ':':'0CC0CC0', '-':'000V000', '/':'11248GG',
    '#':'AAVAVAA', '$':'4FKE5U4', '%':'PQ48JB0', '(':'48GGG84', ')':'4211124', '=':'00V0V00',
    '+':'044V440', '*':'0LEVEL0',
}
_B32 = "0123456789ABCDEFGHIJKLMNOPQRSTUV"
BLACK, RED, BLUE, GREEN, GREY = (0, 0, 0), (208, 32, 32), (32, 80, 208), (32, 160, 64), (200, 200, 200)


class Canvas:
    """Minimal RGB raster + a hand-rolled PNG encoder (zlib is stdlib)."""

    def __init__(self, w: int, h: int, bg: tuple = (255, 255, 255)):
        self.w, self.h = w, h
        self.px = bytearray(bytes(bg) * (w * h))

    def rect(self, x: int, y: int, w: int, h: int, c: tuple) -> None:
        for yy in range(max(0, y), min(self.h, y + h)):
            row = yy * self.w * 3
            for xx in range(max(0, x), min(self.w, x + w)):
                self.px[row + xx * 3: row + xx * 3 + 3] = bytes(c)

    def frame(self, x: int, y: int, w: int, h: int, c: tuple, t: int = 2) -> None:
        self.rect(x, y, w, t, c)
        self.rect(x, y + h - t, w, t, c)
        self.rect(x, y, t, h, c)
        self.rect(x + w - t, y, t, h, c)

    def disc(self, cx: int, cy: int, r: int, c: tuple) -> None:
        for yy in range(cy - r, cy + r + 1):
            dy = yy - cy
            if abs(dy) <= r:
                dx = int((r * r - dy * dy) ** 0.5)
                self.rect(cx - dx, yy, 2 * dx + 1, 1, c)

    def tri_up(self, cx: int, by: int, w: int, h: int, c: tuple) -> None:
        """Upward isosceles triangle: apex at (cx, by - h), base of width w at y = by."""
        for i in range(h):
            half = int(w / 2 * (i / max(1, h - 1)))
            self.rect(cx - half, by - h + 1 + i, 2 * half + 1, 1, c)

    def text(self, x: int, y: int, s: str, scale: int = 4, c: tuple = BLACK) -> None:
        for ch in s.upper():
            for ry, code in enumerate(FONT5X7.get(ch, FONT5X7[" "])):
                bits = _B32.index(code)
                for rx in range(5):
                    if bits >> (4 - rx) & 1:
                        self.rect(x + rx * scale, y + ry * scale, scale, scale, c)
            x += 6 * scale

    def png(self) -> bytes:
        raw = bytearray()
        for y in range(self.h):
            raw.append(0)                       # filter type 0 (none) per scanline
            raw += self.px[y * self.w * 3:(y + 1) * self.w * 3]

        def chunk(tag: bytes, data: bytes) -> bytes:
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
        return (b"\x89PNG\r\n\x1a\n"
                + chunk(b"IHDR", struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(bytes(raw), 6))
                + chunk(b"IEND", b""))


# The receipt is the OCR ground truth: mechanical, unambiguous, and the
# arithmetic is CONSISTENT on purpose (2x12.50 + 34.00 + 5x0.85 + 3x21.40 +
# 18.75 = 146.20, +23% tax = 179.83) so a model cannot "helpfully" correct it.
DOC_LINES = [
    "NORTHGATE HARDWARE",
    "INVOICE 48213 / 2026-03-14",
    "",
    "QTY ITEM          UNIT   AMOUNT",
    "------------------------------",
    "2   BRASS HINGE   12.50   25.00",
    "1   OAK PLANK     34.00   34.00",
    "5   STEEL SCREW    0.85    4.25",
    "3   PAINT CAN     21.40   64.20",
    "1   TAPE MEASURE  18.75   18.75",
    "------------------------------",
    "SUBTOTAL                 146.20",
    "TAX 23%                   33.63",
    "TOTAL                    179.83",
]
CHART_BARS = [("A", 25), ("B", 15), ("C", 40), ("D", 50), ("E", 30)]
DIGIT_GRID = [[3, 8, 1, 6], [9, 4, 5, 2], [7, 0, 8, 3], [2, 6, 9, 1]]


def _img_doc() -> Canvas:
    scale, adv, lh = 4, 24, 40
    c = Canvas(80 + adv * 31, 80 + lh * len(DOC_LINES))
    for i, line in enumerate(DOC_LINES):
        c.text(40, 40 + i * lh, line, scale)
    return c


def _img_scene() -> Canvas:
    c = Canvas(800, 600, (242, 242, 242))
    for x, y in ((60, 60), (300, 200), (120, 380)):     # 3 red squares
        c.rect(x, y, 100, 100, RED)
    for cx, cy in ((560, 120), (660, 330)):             # 2 blue circles
        c.disc(cx, cy, 55, BLUE)
    c.tri_up(380, 530, 170, 140, GREEN)                 # 1 green triangle
    c.text(620, 460, "7", 12, BLACK)                    # one big glyph
    return c


def _img_chart() -> Canvas:
    c = Canvas(800, 560)
    x0, y0, unit = 120, 470, 8
    for v in range(0, 51, 10):
        y = y0 - v * unit
        c.rect(x0, y, 560, 2, GREY)
        c.text(x0 - 80, y - 10, f"{v:>2}", 3)
    c.rect(x0, y0 - 50 * unit, 3, 50 * unit + 3, BLACK)
    c.rect(x0, y0, 560, 3, BLACK)
    for i, (name, v) in enumerate(CHART_BARS):
        bx = x0 + 40 + i * 105
        c.rect(bx, y0 - v * unit, 70, v * unit, BLUE)
        c.text(bx + 20, y0 + 20, name, 4)
    c.text(x0, 30, "UNITS PER SITE", 4)
    return c


def _img_grid() -> Canvas:
    cell, m = 120, 40
    c = Canvas(m * 2 + cell * 4, m * 2 + cell * 4)
    for r, row in enumerate(DIGIT_GRID):
        for col, d in enumerate(row):
            x, y = m + col * cell, m + r * cell
            c.frame(x, y, cell, cell, (120, 120, 120), 2)
            c.text(x + 40, y + 32, str(d), 8)
    return c


IMAGES = {"doc": _img_doc, "scene": _img_scene, "chart": _img_chart, "grid": _img_grid}
_IMG_CACHE: dict[str, str] = {}


def image_data_url(name: str) -> str:
    """PNG -> data: URL, rendered once per process (the raster loops are pure Python)."""
    if name not in _IMG_CACHE:
        png = IMAGES[name]().png()
        _IMG_CACHE[name] = "data:image/png;base64," + base64.b64encode(png).decode()
    return _IMG_CACHE[name]


# ── vision grading ───────────────────────────────────────────────────────────
def _norm(s: str) -> str:
    return re.sub(r"\s+", " ", (s or "").upper()).strip()


def _nums(s: str) -> list[str]:
    return re.findall(r"\d+\.\d+|\d+", s.replace(" ", ""))


def g_first_num(expected: str):
    """First number in the answer must equal `expected` (models answer '3', '3 squares',
    'There are 3 ...' — all fine; '3 red and 2 blue' is still graded on the 3)."""
    def grade(out: str) -> float:
        n = _nums(_norm(out))
        return 1.0 if n and n[0] == expected else 0.0
    return grade


def g_contains(*subs: str):
    def grade(out: str) -> float:
        t = _norm(out)
        return 1.0 if any(s in t for s in subs) else 0.0
    return grade


def g_letter(expected: str):
    def grade(out: str) -> float:
        m = re.search(r"\b([A-E])\b", _norm(out))
        return 1.0 if m and m.group(1) == expected else 0.0
    return grade


def _ocr_key(s: str) -> str:
    """Formatting-insensitive OCR comparison key: letters/digits/decimal points only.
    Whitespace, the ruler dashes and any markdown fences drop out, so a model is not
    punished for reflowing the columns."""
    return re.sub(r"[^A-Z0-9.%]", "", (s or "").upper())


def g_ocr(out: str) -> float:
    """Character F1 against the receipt: recall punishes missed/misread text, precision
    punishes preamble and hallucinated lines. 1.0 = a perfect transcription."""
    tgt, got = _ocr_key("\n".join(DOC_LINES)), _ocr_key(out)
    if not got:
        return 0.0
    matched = sum(b.size for b in difflib.SequenceMatcher(None, tgt, got, autojunk=False)
                  .get_matching_blocks())
    prec, rec = matched / len(got), matched / len(tgt)
    return 0.0 if prec + rec == 0 else 2 * prec * rec / (prec + rec)


@dataclass
class VisionCase:
    name: str
    image: str
    question: str
    truth: str                    # ground truth, for the --list-vision listing
    grade: object                 # str -> float in [0, 1]
    system: str = ("Answer the question about the image. Give only the answer, "
                   "no explanation and no units.")
    n_predict: int = 64

    def body(self, model: str) -> dict:
        return {"model": model, "stream": False, "n_predict": self.n_predict,
                "ignore_eos": False, "cache_prompt": False, "id_slot": 0,
                "messages": [
                    {"role": "system", "content": self.system},
                    {"role": "user", "content": [
                        {"type": "image_url", "image_url": {"url": image_data_url(self.image)}},
                        {"type": "text", "text": self.question}]}]}


_OCR_SYSTEM = ("You are an OCR engine. Transcribe the image exactly as printed, "
               "line by line. Output only the transcription.")

VISION_CASES: dict[str, VisionCase] = {c.name: c for c in [
    VisionCase("ocr", "doc", "Transcribe this receipt.", "the 14 printed lines",
               g_ocr, system=_OCR_SYSTEM, n_predict=512),
    VisionCase("total", "doc", "What is the TOTAL on this receipt?", "179.83",
               g_first_num("179.83")),
    VisionCase("qty", "doc", "How many STEEL SCREW units were bought?", "5",
               g_first_num("5")),
    VisionCase("squares", "scene", "How many red squares are in the image?", "3",
               g_first_num("3")),
    VisionCase("triangle", "scene", "What colour is the triangle?", "green",
               g_contains("GREEN")),
    VisionCase("bigdigit", "scene", "What single digit is printed in the bottom-right corner?",
               "7", g_first_num("7")),
    VisionCase("tallest", "chart", "Which bar is the tallest? Answer with its letter.", "D",
               g_letter("D")),
    VisionCase("barvalue", "chart", "What is the value of bar C?", "40", g_first_num("40")),
    VisionCase("cell", "grid", "The image is a 4x4 grid of digits. Rows are numbered 1-4 from "
               "the top and columns 1-4 from the left. Which digit is in row 2, column 3?",
               "5", g_first_num("5")),
]}
VISION_OCR_CASES = ("ocr",)
VISION_VQA_CASES = ("total", "qty", "squares", "triangle", "bigdigit", "tallest", "barvalue", "cell")

